---
import { createI18n } from "../lib/i18n";
const { language, t, path, localize } = createI18n(Astro.url);
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
import Globe from "../components/Globe";
import { EXPERIENCE as source_EXPERIENCE, PROFILE as source_PROFILE } from "../data/profile";
import { AWARDS as source_AWARDS, CREDENTIALS as source_CREDENTIALS, PORTFOLIO_PROJECTS as source_PORTFOLIO_PROJECTS, WORK_HISTORY as source_WORK_HISTORY } from "../data/career";
import { VISITED_COUNTRIES as source_VISITED_COUNTRIES } from "../data/travel";
const EXPERIENCE = localize(source_EXPERIENCE);
const PROFILE = localize(source_PROFILE);
const AWARDS = localize(source_AWARDS);
const CREDENTIALS = localize(source_CREDENTIALS);
const PORTFOLIO_PROJECTS = localize(source_PORTFOLIO_PROJECTS);
const WORK_HISTORY = localize(source_WORK_HISTORY);
const VISITED_COUNTRIES = localize(source_VISITED_COUNTRIES);
---

<script>
  import { stagger, animate } from "motion";
  const cards = document.querySelectorAll(".card");
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    animate(cards, { y: 0, opacity: 1 }, { duration: 0 });
  } else {
    animate(cards, { y: [20, 0], opacity: [0, 1] }, { duration: .4, delay: stagger(.05) });
  }
</script>

<Layout description={PROFILE.description} title={t("Josue Garza | CX, AI & Automation")}>
  <main class="portfolio text-white m-auto grid gap-4 max-w-6xl relative w-full p-4 md:p-6 md:grid-cols-2 lg:grid-cols-4">
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <TimeZone />
    <Now />
    <Card colSpan="md:col-span-1" href={path("/travel")} rowSpan="lg:row-span-2" title={t("Countries I've visited")}>
      <p class="country-count">{VISITED_COUNTRIES.length} {t("countries and counting")}</p>
      <div class="globe-preview" aria-hidden="true"><Globe language={language} client:visible /></div>
    </Card>
    <Card colSpan="md:col-span-1" href={path("/blog")} rowSpan="lg:row-span-4" title={t("Career highlights")}>
      <ol class="experience-preview">
        {EXPERIENCE.map((job) => (
          <li>
            <span class="company">{job.company}</span>
            <span class="job-role">{job.role}</span>
            <span class="job-period">{job.period}</span>
          </li>
        ))}
      </ol>
      <p class="all-experience">{t("Explore all")} {WORK_HISTORY.length} {t("roles →")}</p>
    </Card>
    <Card colSpan="md:col-span-1" rowSpan="lg:row-span-2">
      <a class="projects-link" href={path("/blog")}>{t("Experience & beyond →")}</a>
      <p class="journey-intro">{t("The projects, learning, and communities behind my work.")}</p>
      <ul class="journey-links">
        <li><a href={path("/blog#projects")}>{PORTFOLIO_PROJECTS.length} {t("projects")} <span aria-hidden="true">↗</span></a></li>
        <li><a href={path("/blog#recognition")}>{AWARDS.length} {t("honors & awards")} <span aria-hidden="true">↗</span></a></li>
        <li><a href={path("/blog#certifications")}>{CREDENTIALS.length} {t("credentials")} <span aria-hidden="true">↗</span></a></li>
        <li><a href={path("/blog#community")}>{t("Community & founding")} <span aria-hidden="true">↗</span></a></li>
      </ul>
    </Card>
  </main>
</Layout>

<style>
  .portfolio { align-items: stretch; }
  .portfolio :global(.card) { min-width: 0; transform: none; }
  .experience-preview { list-style: none; padding: 0; margin: .5rem 0 0; }
  .experience-preview li { display: flex; flex-direction: column; gap: .25rem; padding: .85rem 0; border-bottom: 1px solid #343434; }
  .experience-preview li:last-child { border-bottom: 0; padding-bottom: 0; }
  .company { font-weight: 700; font-size: .95rem; }
  .job-role { font-size: .8rem; line-height: 1.5; color: #d4d4d4; }
  .job-period { color: #a3a3a3; font-size: .75rem; }
  .country-count { color: #bfbfbf; margin: .5rem 0; font-size: .85rem; }
  .globe-preview { width: 100%; height: 130px; }
  .projects-link { color: var(--color-primary-500); font-size: .9rem; line-height: 1.6; text-underline-offset: .25rem; }
  .all-experience { color: var(--color-primary-500); font-size: .8rem; margin: 1rem 0 0; }
  .journey-intro { color: #bfbfbf; font-size: .8rem; line-height: 1.65; margin: .75rem 0; }
  .journey-links { list-style: none; padding: 0; margin: 0; }
  .journey-links a { display: flex; justify-content: space-between; gap: .5rem; color: #d4c9e3; font-size: .78rem; padding: .65rem 0; border-bottom: 1px solid #38313f; text-decoration: none; }
  .journey-links a:hover { color: var(--color-primary-400); }
</style>
