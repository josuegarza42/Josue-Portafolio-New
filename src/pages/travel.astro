---
import Globe from "../components/Globe";
import BasicLayout from "../layouts/BasicLayout.astro";
import { VISITED_COUNTRIES } from "../data/travel";
---

<BasicLayout description={`The ${VISITED_COUNTRIES.length} countries Josue Garza has visited, including the United States.`} page="travel" title="Countries I've visited | Josue Garza">
  <main class="travel-page">
    <a class="back" href="/">← Back to portfolio</a>
    <h1>Countries I've visited</h1>
    <p>{VISITED_COUNTRIES.length} countries. A growing collection of perspectives.</p>
    <div class="travel-globe"><Globe client:load /></div>
    <ul aria-label="Visited countries">
      {VISITED_COUNTRIES.map((country) => <li>{country.name}</li>)}
    </ul>
    <p class="legend"><span aria-hidden="true"></span> Visited countries are highlighted in purple.</p>
  </main>
</BasicLayout>

<style>
  .travel-page { width: 100%; max-width: 48rem; padding: 2rem 1.25rem; color: #f5f5f5; text-align: center; }
  .back { display: inline-block; margin-bottom: 2rem; color: #d4d4d4; text-underline-offset: .25rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 .5rem; }
  p { color: #bfbfbf; line-height: 1.6; }
  .travel-globe { width: min(100%, 480px); aspect-ratio: 1; margin: 1rem auto; }
  ul { display: flex; flex-wrap: wrap; gap: .65rem; list-style: none; justify-content: center; padding: 0; }
  li { border: 1px solid #444; border-radius: 2rem; padding: .55rem .9rem; font-size: .9rem; }
  .legend { margin-top: 1.5rem; font-size: .8rem; }
  .legend span { display: inline-block; width: .6rem; height: .6rem; border-radius: 50%; background: var(--color-primary-500); margin-right: .4rem; }
</style>
