---
import { createI18n } from "../lib/i18n";
const { t, path, localize } = createI18n(Astro.url);
import Card from "./Card/index.astro";
import { PROFILE as source_PROFILE } from "../data/profile";
const PROFILE = localize(source_PROFILE);
---

<Card colSpan="md:col-span-1" rowSpan="lg:row-span-6" title={t("About me")}>
  <div class="about-copy">
    <p>{t("I work at the intersection of customer experience, professional services, and technology.")}</p>
    <p>{t("My focus is solution design, CRM implementation, support automation, and leading projects from scoping to delivery.")}</p>
    <h3>{t("Engineering foundation")}</h3>
    <p>{PROFILE.education}<br /><span>{PROFILE.university}</span></p>
    <h3>{t("How I work")}</h3>
    <p>{t("Clear stakeholder communication, Agile delivery, and practical guidance that helps teams adopt the solutions we build.")}</p>
    <a href={path("/blog#education")}>{t("Education & skills →")}</a>
  </div>
</Card>

<style>
  .about-copy { color: #c3c3c3; font-size: .9rem; line-height: 1.7; }
  p { margin: .9rem 0; }
  h3 { margin: 1.25rem 0 .25rem; font-size: .85rem; font-weight: 700; color: #f5f5f5; }
  span { color: #a3a3a3; }
  a { color: var(--color-primary-500); text-underline-offset: .25rem; }
</style>
