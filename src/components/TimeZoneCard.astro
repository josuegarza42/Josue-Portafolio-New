---
import { createI18n } from "../lib/i18n";
const { language, t } = createI18n(Astro.url);
import Card from "./Card/index.astro";
const now = new Date();
const formatTime = (date: Date) => new Intl.DateTimeFormat(language === "es" ? "es-MX" : "en-US", {
  hour: "numeric", minute: "2-digit", second: "2-digit", hour12: true, timeZone: "America/Mexico_City",
}).format(date);
---

<script>
  const clock = document.getElementById("timeDisplay");
  const formatter = new Intl.DateTimeFormat(document.documentElement.lang === "es" ? "es-MX" : "en-US", {
    hour: "numeric", minute: "2-digit", second: "2-digit", hour12: true, timeZone: "America/Mexico_City",
  });
  const updateClock = () => {
    const now = new Date();
    if (clock) { clock.textContent = formatter.format(now); clock.setAttribute("datetime", now.toISOString()); }
  };
  updateClock();
  const interval = setInterval(updateClock, 1000);
  document.addEventListener("astro:before-swap", () => clearInterval(interval), { once: true });
</script>

<Card colSpan="md:col-span-1 lg:col-span-2" rowSpan="lg:row-span-2" title={t("Mexico City time")}>
  <time datetime={now.toISOString()} id="timeDisplay">{formatTime(now)}</time>
  <p>{t("America/Mexico_City · UTC−6")}</p>
</Card>

<style>
  time { display: block; font-size: clamp(1.5rem, 3vw, 2rem); font-variant-numeric: tabular-nums; margin-top: 1rem; }
  p { color: #a3a3a3; font-size: .8rem; margin: .5rem 0 0; }
</style>
