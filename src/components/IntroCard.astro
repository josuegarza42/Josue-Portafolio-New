---
import { createI18n } from "../lib/i18n";
const { t, localize } = createI18n(Astro.url);
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
import { PROFILE as source_PROFILE } from "../data/profile";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
const PROFILE = localize(source_PROFILE);
---

<Card colSpan="md:col-span-2 lg:col-span-3" rowSpan="lg:row-span-4">
  <div class="intro">
    <div class="intro-copy">
      <p class="eyebrow">{t("Customer experience · AI & automation")}</p>
      <h1>{PROFILE.name}</h1>
      <p class="intro-role">{PROFILE.role} {t("at")} {PROFILE.company}</p>
      <p class="intro-summary">{t("I turn complex customer requirements into practical AI and automation solutions — from solution design and client onboarding to project delivery.")}</p>
      <nav class="intro-links" aria-label={t("Professional profiles")}>
        <a class="resume-link" href={LINKS.resume} target="_blank" rel="noopener noreferrer">{t("View résumé")} <Icon name="ri:arrow-right-up-line" /></a>
        <a class="profile-link" aria-label={t("GitHub profile")} href={LINKS.github} target="_blank" rel="noopener noreferrer"><Icon name="ri:github-fill" /></a>
        <a class="profile-link" aria-label={t("LinkedIn profile")} href={LINKS.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="ri:linkedin-box-fill" /></a>
      </nav>
    </div>
    <Image alt={t("Josue Garza monogram")} class="intro-image" height="220" src="/J.png" width="220" />
  </div>
</Card>

<style>
  .intro { display: flex; align-items: center; gap: 1.5rem; height: 100%; }
  .intro-copy { flex: 1; min-width: 0; }
  .eyebrow { color: var(--color-primary-500); font-size: .75rem; letter-spacing: .07em; text-transform: uppercase; margin: 0 0 .75rem; }
  h1 { font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.05; letter-spacing: -.035em; margin: 0 0 .75rem; }
  .intro-role { color: #f5f5f5; font-size: 1.05rem; margin: 0 0 .75rem; }
  .intro-summary { color: #bfbfbf; font-size: 1rem; line-height: 1.65; max-width: 36rem; margin: 0; }
  .intro-links { display: flex; gap: .75rem; align-items: center; margin-top: 1.5rem; flex-wrap: wrap; }
  .intro-links a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px; border: 1px solid #505050; border-radius: .5rem; text-decoration: none; }
  .intro-links a:hover { border-color: var(--color-primary-600); }
  .intro-links :global(svg) { width: 1.25rem; height: 1.25rem; }
  .resume-link { padding: .65rem 1rem; background: var(--color-primary-500); color: #171717; font-weight: 700; }
  .profile-link { width: 44px; color: #f5f5f5; }
  .intro-image { width: 26%; max-width: 220px; height: auto; flex-shrink: 0; }
  @media (max-width: 600px) { .intro { align-items: flex-start; } .intro-image { width: 64px; } }
  @media (max-width: 380px) { .intro-image { display: none; } }
</style>
