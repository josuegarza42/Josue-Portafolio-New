---
import { createI18n } from "../lib/i18n";
const { t, localize } = createI18n(Astro.url);
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
import { PROFILE as source_PROFILE } from "../data/profile";
const PROFILE = localize(source_PROFILE);
---

<Card colSpan="md:col-span-1" rowSpan="lg:row-span-4" title={t("Let's connect")}>
  <p class="contact-intro">{t("Have a CX challenge or a project in mind?")}</p>
  <address>
    <span class="label">{t("Email")}</span>
    <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
    <span class="label">{t("Based in")}</span>
    <span>{PROFILE.location}</span>
  </address>
  <a class="resume" href={LINKS.resume} target="_blank" rel="noopener noreferrer">{t("View full résumé ↗")}</a>
</Card>

<style>
  .contact-intro { color: #c3c3c3; line-height: 1.6; font-size: .95rem; margin: 1rem 0; }
  address { display: flex; flex-direction: column; font-style: normal; font-size: .9rem; gap: .25rem; }
  .label { color: #a3a3a3; font-size: .8rem; margin-top: .85rem; }
  a { color: var(--color-primary-500); overflow-wrap: anywhere; text-underline-offset: .25rem; }
  .resume { display: inline-block; margin-top: 1.5rem; font-weight: 600; }
</style>
